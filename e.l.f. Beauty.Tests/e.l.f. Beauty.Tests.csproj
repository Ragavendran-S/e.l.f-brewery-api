<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>e.l.f._Beauty.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <!-- Toggle to suppress all compiler warnings in this test project. Set to 'true' to hide warnings temporarily. -->
    <SuppressAllWarnings>true</SuppressAllWarnings>
    <NoWarn Condition="'$(SuppressAllWarnings)' == 'true'">$(NoWarn);ALL</NoWarn>
    <!-- Suppress compatibility warnings for packages that target newer TFMs (e.g., Microsoft.Extensions.Primitives 10.x)
         This prevents build warnings about unsupported target frameworks while still building for net6.0. -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <!-- Suppress specific NuGet warning about package downgrade/resolution (e.g., AutoMapper dependency) -->
    <NoWarn>$(NoWarn);NU1608;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.1.0" />
    <PackageReference Include="coverlet.collector" Version="3.1.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc" Version="2.3.13" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Use AutoMapper 12.x to match application package used by tests -->
    <PackageReference Include="AutoMapper" Version="12.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\e.l.f. Beauty\e.l.f. Beauty.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Controller\" />
  </ItemGroup>
</Project>
