      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc" Version="2.3.13" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AutoMapper" Version="15.1.1" />
    <!-- Removed AutoMapper.Extensions.Microsoft.DependencyInjection from tests; will construct mapper manually in tests if needed -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\..\Downloads\e.l.f-brewery-api-Feature-e.l.f-Brewery-API\e.l.f-brewery-api-Feature-e.l.f-Brewery-API\e.l.f. Beauty\e.l.f. Beauty.csproj" />
